OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
# Public realtime sessions stay disabled unless both the feature flag and an
# explicit Origin allowlist are configured.
REALTIME_PUBLIC_ENABLED=false
REALTIME_ALLOWED_ORIGINS=https://fanworks.io,https://www.fanworks.io

# Contact form (POST /api/contact). Resend is required in production.
# Create a key at https://resend.com/api-keys and set it on Railway.
CONTACT_TO=scottjones08@gmail.com,scott@fanworks.io,mike@fanworks.io,brant@fanworks.io
RESEND_API_KEY=
# Leave empty to send from Resend's test sender (onboarding at resend.dev).
# After fanworks.io is verified in Resend, set:
# RESEND_FROM=FanWorks <hello@fanworks.io>
RESEND_FROM=
CONTACT_WEBHOOK_URL=
