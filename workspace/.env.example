# Set these on a dedicated Railway service for app.fanworks.io.
DATABASE_URL=postgresql://user:password@host:5432/database
APP_ORIGIN=https://app.fanworks.io
NODE_ENV=production
# Set DATABASE_SSL=require only if your database endpoint requires verified TLS.
DATABASE_SSL=

# For the one-time admin setup command, supply these in the command environment.
# Do not retain ADMIN_PASSWORD as a long-lived service variable.
ADMIN_NAME=
ADMIN_EMAIL=scott@fanworks.io
ADMIN_PASSWORD=
